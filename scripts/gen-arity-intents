#!/usr/bin/env python3
"""Regenerate the n-arity section of tests/intents/mutations.toml.

Everything from the BEGIN marker line to the end of the file is owned by
this script; run it from anywhere to rewrite that section in place. The
fixture generator cannot yet name hundreds of items, so the 300 nonce
transactions per vector are emitted here (until fixture-gen can number
items itself).
"""
import base64
import pathlib

BEGIN = "# BEGIN generated by scripts/gen-arity-intents (do not edit by hand)"
PATH = pathlib.Path(__file__).resolve().parent.parent / "tests/intents/mutations.toml"

LEVELS = {  # level: (nonce typ prefix, description, nonces for a 256-item node)
    "kt": ("AT/KT/nonce", "KT (KR counts the key and its nonces)", 255),
    "at": ("AT/nonce", "AT (AR counts KR and its nonces)", 255),
    "pr": ("nonce", "PR (PR counts SR, CR and its nonces)", 254),
}
OVER = 300


def nonce(i: int) -> str:
    raw = i.to_bytes(2, "big") + bytes([0xEE]) * 30
    return "SHA-256:" + base64.urlsafe_b64encode(raw).decode().rstrip("=")


def commit(typ: str, ids, now: int) -> str:
    out = "[[test.commit]]\ntx = [\n"
    for i in ids:
        out += (
            f'  [\n    {{ now = {now}, signer = "golden", '
            f'target = "raw:{nonce(i)}", typ = "cyphr.me/cyphr/{typ}" }},\n  ],\n'
        )
    return out + "]\n\n"


def section() -> str:
    out = [
        BEGIN,
        "#",
        "# n-arity (SPEC 4, line 463): a collection node holds more than 256",
        "# items. Each level has three vectors: a full 256-item fold, an",
        f"# overflow of {OVER} nonces past one fold, and {OVER} nonces created then",
        "# deleted back to 256 items. The delete vector's final KR, AR and SR",
        "# equal the full-fold vector's; its PR differs only through the longer",
        "# commit chain (CR), which PR folds in.\n",
    ]
    for lvl, (typ, desc, fill) in LEVELS.items():
        base = "[test.expected]\nkey_count = 1\n\n"
        out.append(
            f"# {desc}: exactly 256 items, the largest single-fold node.\n"
            f'[[test]]\nname      = "arity_{lvl}_full_fold_256_items"\n'
            'principal = ["golden"]\n\n'
            + commit(typ + "/create", range(fill), 1700000000)
            + base
        )
        out.append(
            f"# {desc}: {OVER} nonces, past one fold.\n"
            f'[[test]]\nname      = "arity_{lvl}_overflow_past_256_items"\n'
            'principal = ["golden"]\n\n'
            + commit(typ + "/create", range(OVER), 1700000000)
            + base
        )
        out.append(
            f"# {desc}: {OVER} nonces created, the surplus deleted: KR, AR and\n"
            f"# SR equal those of arity_{lvl}_full_fold_256_items.\n"
            f'[[test]]\nname      = "arity_{lvl}_delete_back_to_256_items"\n'
            'principal = ["golden"]\n\n'
            + commit(typ + "/create", range(OVER), 1700000000)
            + commit(typ + "/delete", range(fill, OVER), 1700000001)
            + base
        )
    return "\n".join(out).rstrip("\n") + "\n"


def main() -> None:
    text = PATH.read_text()
    head = text[: text.index(BEGIN)]
    PATH.write_text(head + section())


if __name__ == "__main__":
    main()
