#!/usr/bin/env bash
# Bounded id-indirection runner for docket claims whose `@docket:` marker
# names this script plus a claim id. A conjunctive requirement needing
# several tests to jointly close it registers them all under one id.
#
# CLAIMS_INDEX maps a claim id to the name of a real bash ARRAY (via
# nameref, below) — not a single joined shell string (`a && b`), which
# would satisfy a black-box exit code without the underlying data
# actually being list-shaped. Every command in the array runs, in
# order; the claim only passes if every one of them exits 0.
#
# A marker naming this script plus a short id is fixed-length regardless
# of how long the underlying commands are or how many a claim needs —
# `@docket: <id> :: scripts/docket-run <id>` never risks a comment's
# column-wrap limit the way inlining a raw multi-command invocation
# would.
#
# Usage: docket-run <claim-id>
#        docket-run --self-check   (prove the zero-test rule; see below)
set -uo pipefail

# claim id -> name of the bash array holding its command list. Bash
# variable names cannot contain '-', so the index translates each
# hyphenated claim id to its array's underscored name; a new claim adds
# one line here plus the array it names.
declare -A CLAIMS_INDEX=(
  [list-valued-both-green]="_claim_list_valued_both_green"
  [list-valued-one-failing]="_claim_list_valued_one_failing"

  # Equivocation claims (docs/architecture/equivocation-detection.md).
  # Entries for claims the documents no longer define, and for claims
  # with no test yet, are absent rather than vacuous: `docket run` then
  # reports them absent until their owner writes the test and adds the
  # entry. Four claims below name a test that does not exist yet; they
  # FAIL on purpose (see the zero-test rule at the foot of this file).
  [arch-detection-is-comparison]="_claim_arch_detection_is_comparison"
  [arch-tip-reports-are-material]="_claim_arch_tip_reports_are_material"
  [arch-behind-is-not-fork]="_claim_arch_behind_is_not_fork"
  [arch-signing-stays-stateless]="_claim_arch_signing_stays_stateless"
  [arch-finding-never-clears]="_claim_arch_finding_never_clears"
  [arch-verifier-chooses-peers]="_claim_arch_verifier_chooses_peers"

  # Sign-on claims (docs/architecture/path-a-sovereign-sign-on.md); each
  # names the one scenario test that closes it.
  [signon-honest-refusal]="_claim_signon_honest_refusal"
  [signon-disowned-key]="_claim_signon_disowned_key"
  [signon-token-kind-binding]="_claim_signon_token_kind_binding"
  [signon-claimed-principal]="_claim_signon_claimed_principal"
  [signon-key-active-in-principal]="_claim_signon_key_active_in_principal"
  [signon-replay-bound]="_claim_signon_replay_bound"
  [signon-audience-binding]="_claim_signon_audience_binding"

  # SPEC conformance claims (SC1): each id is the SPEC line a
  # `@docket: sc-l<N>` marker in a spec_conformance.rs names.
  [sc-l119]="_claim_sc_l119"
  [sc-l203]="_claim_sc_l203"
  [sc-l237]="_claim_sc_l237"
  [sc-l240]="_claim_sc_l240"
  [sc-l246]="_claim_sc_l246"
  [sc-l592]="_claim_sc_l592"
  [sc-l944]="_claim_sc_l944"
  [sc-l1059]="_claim_sc_l1059"
  [sc-l1287]="_claim_sc_l1287"
  [sc-l1300]="_claim_sc_l1300"
  [sc-l1869]="_claim_sc_l1869"
  [sc-l2827]="_claim_sc_l2827"
  [sc-l2828]="_claim_sc_l2828"
  [sc-l3054]="_claim_sc_l3054"
  [sc-l3350]="_claim_sc_l3350"
  [sc-l3353]="_claim_sc_l3353"

  # Record-verification claims (docs/architecture/record-verification.md);
  # each names the replay-rule tests that close it.
  [rv-coz-wellformed]="_claim_rv_coz_wellformed"
  [rv-sig-verifies]="_claim_rv_sig_verifies"
  [rv-timestamp-range]="_claim_rv_timestamp_range"
  [rv-alg-alignment]="_claim_rv_alg_alignment"
  [rv-timestamp-monotone]="_claim_rv_timestamp_monotone"
  [rv-key-set]="_claim_rv_key_set"
  [rv-alg-support]="_claim_rv_alg_support"
  [rv-key-material]="_claim_rv_key_material"
  [rv-digest-wellformed]="_claim_rv_digest_wellformed"
  [rv-arrow-chain]="_claim_rv_arrow_chain"
  [rv-state-recomputed]="_claim_rv_state_recomputed"
  [rv-key-active-gate]="_claim_rv_key_active_gate"
  [rv-lifecycle-gate]="_claim_rv_lifecycle_gate"
  [rv-genesis-immutable]="_claim_rv_genesis_immutable"
  [rv-intra-commit-shape]="_claim_rv_intra_commit_shape"
  [rv-no-coz-reuse]="_claim_rv_no_coz_reuse"

  # Self-checks of the zero-test rule itself, run by
  # `docket-run --self-check`; not project claims. The first must FAIL
  # (its test name matches nothing), the second must pass.
  [selfcheck-zero-tests]="_claim_selfcheck_zero_tests"
  [selfcheck-env-prefix-zero]="_claim_selfcheck_env_prefix_zero"
  [selfcheck-cd-prefix-zero]="_claim_selfcheck_cd_prefix_zero"
  [selfcheck-piped-failure]="_claim_selfcheck_piped_failure"
  [selfcheck-real-test]="_claim_selfcheck_real_test"
)

# scripts/docket-fixtures/list-valued-map/CONTRACT.md's own self-check
# entries, proving the list-valued mechanism itself rather than any
# project claim. Real entries join this table as docs/architecture and
# docs/use gain markers that reference them.
_claim_list_valued_both_green=(
  "true"
  "true"
)
_claim_list_valued_one_failing=(
  "true"
  "false"
