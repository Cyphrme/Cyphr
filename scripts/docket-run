_claim_selfcheck_zero_tests=(
  "cargo test --manifest-path rs/Cargo.toml -p cyphr-server --lib no_such_test_exists_anywhere -- --exact"
)
_claim_selfcheck_env_prefix_zero=(
  "CARGO_TERM_COLOR=never cargo test --manifest-path rs/Cargo.toml -p cyphr-server --lib no_such_test_exists_anywhere -- --exact"
)
_claim_selfcheck_cd_prefix_zero=(
  "cd rs && cargo test -p cyphr-server --lib no_such_test_exists_anywhere -- --exact"
)
# A self-owned synthetic failure: one passing and one failing result line,
# exit 101, and a pipe between the producer and the exit code. The pipe
# must not mask the failure, and no project test is borrowed, so fixing a
# project bug cannot turn this check vacuous.
_claim_selfcheck_piped_failure=(
  "( echo 'test result: ok. 1 passed;'; echo 'test result: FAILED. 0 passed; 1 failed;'; exit 101 ) | cat"
)
_claim_selfcheck_real_test=(
  "cargo test --manifest-path rs/Cargo.toml -p cyphr-server --lib verify_rejects_valid_signature_with_wrong_typ"
)

# --self-check: the zero-test rule's own acceptance test. A command
# naming a missing test must fail, one naming a real test must pass;
# each assertion runs independently and the exit code is nonzero iff any
# failed.
if [ "${1:-}" = "--self-check" ]; then
  bad=0
  for sc in selfcheck-zero-tests selfcheck-env-prefix-zero selfcheck-cd-prefix-zero selfcheck-piped-failure; do
    if "${BASH_SOURCE[0]}" "$sc" >/dev/null 2>&1; then
      echo "FAIL  $sc passed though it must fail" >&2
      bad=1
    else
      echo "PASS  $sc fails"
    fi
  done
  if "${BASH_SOURCE[0]}" selfcheck-real-test >/dev/null 2>&1; then
    echo "PASS  a command naming a real test passes"
  else
    echo "FAIL  a command naming a real test failed" >&2
    bad=1
  fi
  exit "$bad"
fi

if [ "$#" -ne 1 ]; then
  echo "usage: docket-run <claim-id> | --self-check" >&2
  exit 2
fi

id="$1"
arrname="${CLAIMS_INDEX[$id]:-}"
if [ -z "$arrname" ]; then
  echo "docket-run: no CLAIMS entry for claim id '$id'" >&2
  exit 2
fi

declare -n cmds="$arrname"

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root" || exit 2

# Zero-test rule: a command that runs no test proves nothing, so it
# fails. cargo exits 0 for a name filter that matches nothing ("0 passed;
# 0 failed; N filtered out"), which let a claim pass by naming a test
# that does not exist. The rule sums the "N passed" counts of every
# "test result:" line a command printed, and applies to EVERY command
# however it is spelled (env prefix, `cd x &&`, wrapper): a rule keyed on
# the command's text is dodged by rewording it. Only the fixture claims
# below are exempt, because their `true`/`false` commands run no test by
# design.
_exempt_from_zero_test_rule=(list-valued-both-green list-valued-one-failing)

failures=0
out="$(mktemp)"
trap 'rm -f "$out"' EXIT
for cmd in "${cmds[@]}"; do
  # pipefail: a claim command that pipes cargo through another tool
  # must not let the tool's exit 0 hide cargo's failure.
  bash -o pipefail -c "$cmd" 2>&1 | tee "$out"
  rc="${PIPESTATUS[0]}"
  if [ "$rc" -ne 0 ]; then
    echo "docket-run: '$id' command failed: $cmd" >&2
    failures=1
    continue
  fi
  # A FAILED summary line fails the command whatever its exit code said.
  if grep -q '^test result: FAILED' "$out"; then
    echo "docket-run: '$id' command reported failing tests: $cmd" >&2
    failures=1
    continue
  fi
  for ex in "${_exempt_from_zero_test_rule[@]}"; do
    [ "$id" = "$ex" ] && continue 2
  done
  passed="$(sed -n 's/^test result: ok\. \([0-9][0-9]*\) passed.*/\1/p' "$out" | awk '{n += $1} END {print n + 0}')"
  if [ "${passed:-0}" -lt 1 ]; then
    echo "docket-run: '$id' command ran zero tests: $cmd" >&2
    failures=1
  fi
done

exit "$failures"
